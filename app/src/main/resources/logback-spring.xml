<configuration>
  <!-- Dependency messages may contain prompts, SQL values or authorization headers. -->
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%date{ISO8601} %level %logger{36}%n%nopex</pattern></encoder>
  </appender>
  <root level="WARN"><appender-ref ref="console"/></root>
</configuration>
